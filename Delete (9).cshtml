@model QuanLyKhachSan.Models.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";

    string giaTri(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
    }
}

<style>
    .customer-delete-page {
        padding-bottom: 35px;
        color: #263b4a;
        animation: deleteFade .4s ease both;
    }

    .delete-hero {
        padding: 27px 30px;
        margin-bottom: 24px;
        border-radius: 18px;
        color: white;
        background: linear-gradient(120deg, #b94d59, #df777b);
        box-shadow: 0 9px 24px rgba(185, 77, 89, .15);
    }

        .delete-hero h2 {
            margin-bottom: 7px;
            font-size: 25px;
            font-weight: 750;
        }

        .delete-hero p {
            margin: 0;
            color: rgba(255,255,255,.85);
            font-size: 14px;
        }

    .delete-card {
        max-width: 760px;
        margin: 0 auto;
        overflow: hidden;
        background: white;
        border: 1px solid #e8eef2;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(36, 67, 86, .05);
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 22px 25px;
        background: #fff7f5;
        border-bottom: 1px solid #f6e7e5;
    }

    .delete-warning-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 13px;
        color: #d45d5d;
        background: #ffe8e5;
        font-size: 21px;
    }

    .delete-warning h5 {
        margin: 1px 0 5px;
        color: #a83e46;
        font-size: 15px;
        font-weight: 750;
    }

    .delete-warning p {
        margin: 0;
        color: #9b7373;
        font-size: 13px;
        line-height: 1.6;
    }

    .delete-profile {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 23px 25px;
        border-bottom: 1px solid #edf1f4;
    }

    .delete-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        flex-shrink: 0;
        border-radius: 16px;
        color: #168596;
        background: #e6f5f6;
        font-size: 22px;
        font-weight: 800;
    }

    .delete-profile-name {
        margin-bottom: 5px;
        color: #263b4a;
        font-size: 17px;
        font-weight: 750;
    }

    .delete-profile-subtitle {
        color: #8797a2;
        font-size: 12px;
    }

    .delete-info {
        padding: 8px 25px;
    }

    .delete-info-row {
        display: grid;
        grid-template-columns: 160px minmax(0, 1fr);
        gap: 12px;
        padding: 15px 0;
        border-bottom: 1px solid #eef2f4;
        font-size: 13px;
    }

        .delete-info-row:last-child {
            border-bottom: 0;
        }

    .delete-info-label {
        color: #8998a3;
        font-weight: 600;
    }

    .delete-info-value {
        color: #405766;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        padding: 20px 25px;
        background: #fbfcfd;
        border-top: 1px solid #edf1f4;
    }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border: 0;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

        .delete-btn:hover {
            transform: translateY(-2px);
        }

    .delete-confirm {
        color: white;
        background: #d45d5d;
    }

        .delete-confirm:hover {
            color: white;
            background: #bd454d;
        }

    .delete-back {
        color: #607482;
        background: white;
        border: 1px solid #dce6eb;
    }

        .delete-back:hover {
            color: #263b4a;
            background: #f0f5f7;
        }

    @@keyframes deleteFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 576px) {
        .delete-info-row {
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .delete-btn {
            width: 100%;
        }
    }
</style>

<div class="customer-delete-page">

    <div class="delete-hero">
        <h2>Xóa khách hàng</h2>
        <p>Xác nhận thông tin trước khi thực hiện thao tác xóa.</p>
    </div>

    <div class="delete-card">

        <div class="delete-warning">
            <div class="delete-warning-icon">!</div>
            <div>
                <h5>Bạn có chắc chắn muốn xóa khách hàng này?</h5>
                <p>
                    Thao tác xóa có thể không thể hoàn tác.
                    Hãy kiểm tra thông tin trước khi tiếp tục.
                </p>
            </div>
        </div>

        <div class="delete-profile">
            <div class="delete-avatar">
                @(string.IsNullOrWhiteSpace(Model.HoTen)
                    ? "?"
                    : Model.HoTen.Trim().Substring(0, 1).ToUpper())
            </div>

            <div>
                <div class="delete-profile-name">@Model.HoTen</div>
                <div class="delete-profile-subtitle">Hồ sơ khách hàng</div>
            </div>
        </div>

        <div class="delete-info">
            <div class="delete-info-row">
                <div class="delete-info-label">Họ và tên</div>
                <div class="delete-info-value">@giaTri(Model.HoTen)</div>
            </div>

            <div class="delete-info-row">
                <div class="delete-info-label">CCCD</div>
                <div class="delete-info-value">@giaTri(Model.CCCD)</div>
            </div>

            <div class="delete-info-row">
                <div class="delete-info-label">Số điện thoại</div>
                <div class="delete-info-value">@giaTri(Model.SoDienThoai)</div>
            </div>

            <div class="delete-info-row">
                <div class="delete-info-label">Email</div>
                <div class="delete-info-value">@giaTri(Model.Email)</div>
            </div>

            <div class="delete-info-row">
                <div class="delete-info-label">Địa chỉ</div>
                <div class="delete-info-value">@giaTri(Model.DiaChi)</div>
            </div>
        </div>

        <form asp-action="Delete"
              asp-route-makhach="@Model.MaKhach"
              method="post">

            @Html.AntiForgeryToken()

            <div class="delete-actions">
                <a asp-action="Index" class="delete-btn delete-back">
                    ← Quay lại
                </a>

                <button type="submit" class="delete-btn delete-confirm">
                    Xác nhận xóa
                </button>
            </div>
        </form>

    </div>
</div>
