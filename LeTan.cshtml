@using QuanLyKhachSan.Models
@using System.Collections.Generic

@{
    ViewData["Title"] = "Tổng quan lễ tân";

    var tongPhong = ViewBag.TongPhong ?? 0;
    var phongTrong = ViewBag.PhongTrong ?? 0;
    var phongDangO = ViewBag.PhongDangO ?? 0;
    var phongDangDon = ViewBag.PhongDangDon ?? 0;
    var phongBaoTri = ViewBag.PhongBaoTri ?? 0;

    var datPhongHomNay = ViewBag.DatPhongHomNay ?? 0;
    var khachDangLuuTru = ViewBag.KhachDangLuuTru ?? 0;
    var sapDen = ViewBag.SapDen ?? 0;
    var sapDi = ViewBag.SapDi ?? 0;

    var datPhongTuan = ViewBag.DatPhongTuan as IEnumerable<DatPhong>
        ?? Enumerable.Empty<DatPhong>();
}

<style>
    .reception-dashboard {
        color: #18365F;
    }

    .reception-welcome {
        padding: 28px;
        border-radius: 18px;
        color: white;
        background: linear-gradient(110deg, #173B70, #347FC2);
        margin-bottom: 24px;
    }

        .reception-welcome h2 {
            color: white;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .reception-welcome p {
            color: rgba(255,255,255,.82);
            margin-bottom: 18px;
        }

    .reception-label {
        font-size: 12px;
        letter-spacing: 2px;
        color: #C8E2FF;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .reception-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .reception-card {
        background: white;
        border: 1px solid #E5EAF3;
        border-radius: 15px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 4px 16px rgba(25,55,95,.04);
        transition: .2s;
    }

        .reception-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(25,55,95,.08);
        }

    .reception-card-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .reception-blue {
        background: #EAF2FC;
        color: #2563A6;
    }

    .reception-green {
        background: #E6F7F0;
        color: #15966A;
    }

    .reception-orange {
        background: #FFF3E4;
        color: #E58A22;
    }

    .reception-purple {
        background: #F0EBFF;
        color: #7656C9;
    }

    .reception-card-label {
        font-size: 13px;
        color: #7889A3;
        margin-top: 14px;
    }

    .reception-card-number {
        font-size: 29px;
        font-weight: 750;
        color: #18365F;
    }

    .reception-card-note {
        font-size: 12px;
        color: #8795A9;
    }

    .reception-panel {
        background: white;
        border: 1px solid #E5EAF3;
        border-radius: 15px;
        padding: 21px;
        height: 100%;
        box-shadow: 0 4px 16px rgba(25,55,95,.04);
    }

    .reception-panel-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 17px;
    }

    .reception-operation {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 0;
        border-bottom: 1px solid #EDF0F5;
    }

        .reception-operation:last-child {
            border-bottom: 0;
        }

    .reception-operation-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #EAF2FC;
        color: #2563A6;
        font-size: 18px;
        flex-shrink: 0;
    }

    .reception-operation-info {
        flex: 1;
    }

        .reception-operation-info strong {
            display: block;
            font-size: 14px;
        }

        .reception-operation-info span {
            color: #8795A9;
            font-size: 12px;
        }

    .reception-operation-number {
        font-size: 19px;
        font-weight: 700;
    }

    .reception-action {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 100%;
        padding: 14px;
        border: 1px solid #E5EAF3;
        border-radius: 12px;
        color: #18365F;
        text-decoration: none;
        transition: .2s;
    }

        .reception-action:hover {
            background: #F5F9FF;
            border-color: #8CB5E3;
            color: #2563A6;
            transform: translateY(-2px);
        }

    .reception-action-icon {
        width: 41px;
        height: 41px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #EAF2FC;
        color: #2563A6;
        font-size: 19px;
        flex-shrink: 0;
    }

    .reception-action strong {
        font-size: 13px;
    }

    .reception-table {
        vertical-align: middle;
        margin-bottom: 0;
    }

        .reception-table th {
            background: #F6F8FC;
            color: #7889A3;
            font-size: 12px;
            padding: 12px;
            white-space: nowrap;
        }

        .reception-table td {
            font-size: 13px;
            padding: 13px 12px;
        }

    .reception-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #EAF2FC;
        color: #2563A6;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    @@media (max-width: 767px) {
        .reception-welcome {
            padding: 22px;
        }

        .reception-card {
            padding: 15px;
        }
    }
</style>

<div class="reception-dashboard">

    <!-- CHÀO MỪNG LỄ TÂN -->
    <section class="reception-welcome">
        <div class="reception-label">HOTEL MANAGEMENT SYSTEM</div>

        <h2>Xin chào, Nhân viên Lễ tân!</h2>

        <p>
            Chúc bạn một ngày làm việc hiệu quả.
            Hãy cùng quản lý hoạt động tiếp đón khách hôm nay.
        </p>

        <a asp-controller="DatPhongs"
           asp-action="Create"
           class="btn btn-light fw-semibold px-4">
            + Tạo đặt phòng mới
        </a>
    </section>

    <!-- THỐNG KÊ -->
    <div class="reception-title">Tình hình khách sạn hôm nay</div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="reception-card">
                <div class="reception-card-icon reception-blue">▣</div>
                <div class="reception-card-label">Phòng còn trống</div>
                <div class="reception-card-number">@phongTrong</div>
                <div class="reception-card-note">
                    Trên tổng @tongPhong phòng
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="reception-card">
                <div class="reception-card-icon reception-green">▦</div>
                <div class="reception-card-label">Đặt phòng hôm nay</div>
                <div class="reception-card-number">@datPhongHomNay</div>
                <div class="reception-card-note">
                    Lượt khách dự kiến nhận phòng
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="reception-card">
                <div class="reception-card-icon reception-orange">♙</div>
                <div class="reception-card-label">Khách đang lưu trú</div>
                <div class="reception-card-number">@khachDangLuuTru</div>
                <div class="reception-card-note">
                    Lượt đặt phòng đã check-in
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="reception-card">
                <div class="reception-card-icon reception-purple">◷</div>
                <div class="reception-card-label">Phòng đang dọn</div>
                <div class="reception-card-number">@phongDangDon</div>
                <div class="reception-card-note">
                    Phòng đang vệ sinh
                </div>
            </div>
        </div>

    </div>

    <!-- NHẬN PHÒNG VÀ TRẢ PHÒNG -->
    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="reception-panel">
                <div class="reception-panel-title">
                    Lịch tiếp đón hôm nay
                </div>

                <div class="reception-operation">
                    <div class="reception-operation-icon">↓</div>
                    <div class="reception-operation-info">
                        <strong>Khách nhận phòng</strong>
                        <span>Dự kiến check-in hôm nay</span>
                    </div>
                    <div class="reception-operation-number">@sapDen</div>
                </div>

                <div class="reception-operation">
                    <div class="reception-operation-icon">↑</div>
                    <div class="reception-operation-info">
                        <strong>Khách trả phòng</strong>
                        <span>Dự kiến check-out hôm nay</span>
                    </div>
                    <div class="reception-operation-number">@sapDi</div>
                </div>

                <div class="reception-operation">
                    <div class="reception-operation-icon">✓</div>
                    <div class="reception-operation-info">
                        <strong>Phòng sẵn sàng</strong>
                        <span>Phòng có thể phục vụ khách</span>
                    </div>
                    <div class="reception-operation-number">@phongTrong</div>
                </div>

                <div class="reception-operation">
                    <div class="reception-operation-icon">⚒</div>
                    <div class="reception-operation-info">
                        <strong>Phòng bảo trì</strong>
                        <span>Phòng tạm ngừng phục vụ</span>
                    </div>
                    <div class="reception-operation-number">@phongBaoTri</div>
                </div>
            </div>
        </div>

        <!-- THAO TÁC NHANH -->
        <div class="col-lg-6">
            <div class="reception-panel">
                <div class="reception-panel-title">Nghiệp vụ lễ tân</div>

                <div class="row g-3">

                    <div class="col-6">
                        <a asp-controller="DatPhongs"
                           asp-action="Create"
                           class="reception-action">
                            <span class="reception-action-icon">＋</span>
                            <strong>Tạo đặt phòng</strong>
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="DatPhongs"
                           asp-action="Index"
                           class="reception-action">
                            <span class="reception-action-icon">▦</span>
                            <strong>Quản lý đặt phòng</strong>
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="Phongs"
                           asp-action="Index"
                           class="reception-action">
                            <span class="reception-action-icon">▣</span>
                            <strong>Tình trạng phòng</strong>
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="KhachHangs"
                           asp-action="Index"
                           class="reception-action">
                            <span class="reception-action-icon">♙</span>
                            <strong>Khách hàng</strong>
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="HoaDons"
                           asp-action="Index"
                           class="reception-action">
                            <span class="reception-action-icon">▤</span>
                            <strong>Hóa đơn</strong>
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="Phongs"
                           asp-action="TimPhongTrong"
                           class="reception-action">
                            <span class="reception-action-icon">⌕</span>
                            <strong>Tìm phòng trống</strong>
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- LỊCH ĐẶT PHÒNG -->
    <div class="reception-panel mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="reception-panel-title mb-0">
                Đặt phòng trong 7 ngày tới
            </div>

            <a asp-controller="DatPhongs"
               asp-action="Index"
               class="text-decoration-none small fw-semibold">
                Xem tất cả
            </a>
        </div>

        <div class="table-responsive">
            <table class="table reception-table">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Ngày nhận</th>
                        <th>Ngày trả</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!datPhongTuan.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Chưa có lịch đặt phòng trong 7 ngày tới.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var datPhong in datPhongTuan)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @(datPhong.KhachHang?.HoTen ?? "Chưa có thông tin")
                                    </strong>
                                </td>

                                <td>@(datPhong.Phong?.SoPhong ?? "—")</td>

                                <td>@datPhong.NgayDen.ToString("dd/MM/yyyy")</td>

                                <td>@datPhong.NgayDi.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <span class="reception-status">
                                        @datPhong.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
