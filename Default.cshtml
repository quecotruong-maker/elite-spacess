@model int

<a class="nav-link position-relative"
   asp-controller="ThongBao"
   asp-action="Index">

    <span style="font-size: 19px;">🔔</span>
    Thông báo

    @if (Model > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
              style="font-size: 10px;">
            @Model
        </span>
    }
</a>