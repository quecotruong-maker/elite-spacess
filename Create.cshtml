@model QuanLyKhachSan.Models.DatPhong

@{
    ViewData["Title"] = "Đặt phòng mới";

    var phong = ViewBag.ThongTinPhong as QuanLyKhachSan.Models.Phong;

    var lichDatPhongJson = System.Text.Json.JsonSerializer.Serialize(
        ViewBag.LichDatPhong ?? new List<object>()
    );
}

<style>
    .booking-calendar {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 20px;
        background: #fff;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .calendar-header button {
            border: 1px solid #ced4da;
            background: white;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: 18px;
            cursor: pointer;
        }

            .calendar-header button:hover {
                background: #e9f2f7;
            }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        text-align: center;
    }

    .calendar-weekday {
        font-weight: 600;
        color: #6c757d;
        padding: 8px 0;
        font-size: 13px;
    }

    .calendar-day {
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #f3f8fa;
        font-size: 14px;
    }

        .calendar-day.booked {
            background: #dc3545;
            color: white;
            font-weight: bold;
        }

        .calendar-day.today {
            border: 2px solid #0d6efd;
            font-weight: bold;
        }

        .calendar-day.empty {
            background: transparent;
        }

    .calendar-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 18px;
        font-size: 13px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .legend-color {
        width: 15px;
        height: 15px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .booking-warning {
        display: none;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
        line-height: 1.6;
    }

        .booking-warning.error {
            display: block;
            background: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        .booking-warning.success {
            display: block;
            background: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }
</style>

<div class="container py-4">

    <h2 class="mb-3">Thông tin đặt phòng</h2>
    <hr />

    <div class="row g-4">

        <!-- CỘT TRÁI: THÔNG TIN PHÒNG -->
        @if (phong != null)
        {
            <div class="col-lg-5">

                <div class="card shadow-sm border-0 h-100">

                    @if (!string.IsNullOrWhiteSpace(phong.HinhAnh))
                    {
                        <img src="@phong.HinhAnh"
                             class="card-img-top"
                             alt="Ảnh phòng @phong.SoPhong"
                             style="height:280px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height:280px;">
                            <span class="text-muted">
                                Chưa có hình ảnh phòng
                            </span>
                        </div>
                    }

                    <div class="card-body">

                        <h4 class="card-title">
                            Phòng @phong.SoPhong
                        </h4>

                        <p class="text-primary fw-bold fs-5">
                            @(phong.LoaiPhong?.GiaMotDem.ToString("N0") ?? "0") đ / đêm
                        </p>

                        <hr />

                        <p>
                            <strong>Loại phòng:</strong>
                            @(phong.LoaiPhong?.TenLoai ?? "Chưa xác định")
                        </p>

                        <p>
                            <strong>Số người tối đa:</strong>
                            @(phong.LoaiPhong?.SoNguoiToiDa.ToString() ?? "Chưa xác định")
                        </p>

                        <p class="mb-0">
                            <strong>Mô tả:</strong>
                            @(phong.LoaiPhong?.MoTa ?? "Chưa có mô tả")
                        </p>

                    </div>
                </div>

            </div>
        }

        <!-- CỘT PHẢI: ĐẶT PHÒNG VÀ LỊCH -->
        <div class="col-lg-7">

            <!-- THÔNG TIN ĐẶT PHÒNG -->
            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4">

                    <h4 class="mb-4">Thông tin đặt phòng</h4>

                    <form asp-action="Create"
                          method="post"
                          id="bookingForm">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        @if (User.IsInRole("Admin") || User.IsInRole("LeTan"))
                        {
                            <div class="mb-3">

                                <label asp-for="MaKhach"
                                       class="form-label"></label>

                                <select asp-for="MaKhach"
                                        class="form-select"
                                        asp-items="ViewBag.MaKhach">

                                    <option value="">
                                        -- Chọn khách hàng --
                                    </option>

                                </select>

                                <span asp-validation-for="MaKhach"
                                      class="text-danger"></span>

                                <div class="form-text">
                                    Khách chưa có trong danh sách?

                                    <a asp-controller="KhachHangs"
                                       asp-action="Create">
                                        Thêm khách hàng mới
                                    </a>
                                </div>

                            </div>
                        }

                        <input type="hidden" asp-for="MaPhong" />

                        @if (phong == null)
                        {
                            <div class="mb-3">

                                <label asp-for="MaPhong"
                                       class="form-label"></label>

                                <select asp-for="MaPhong"
                                        class="form-select"
                                        asp-items="ViewBag.MaPhong">

                                    <option value="">
                                        -- Chọn phòng --
                                    </option>

                                </select>

                                <span asp-validation-for="MaPhong"
                                      class="text-danger"></span>

                            </div>
                        }

                        <!-- NGÀY ĐẾN -->
                        <div class="mb-3">

                            <label asp-for="NgayDen"
                                   class="form-label"></label>

                            <input asp-for="NgayDen"
                                   type="date"
                                   class="form-control"
                                   id="NgayDen" />

                            <span asp-validation-for="NgayDen"
                                  class="text-danger"></span>

                        </div>

                        <!-- NGÀY ĐI -->
                        <div class="mb-3">

                            <label asp-for="NgayDi"
                                   class="form-label"></label>

                            <input asp-for="NgayDi"
                                   type="date"
                                   class="form-control"
                                   id="NgayDi" />

                            <span asp-validation-for="NgayDi"
                                  class="text-danger"></span>

                        </div>

                        <!-- THÔNG BÁO NGÀY TRÙNG -->
                        <div id="bookingWarning"
                             class="booking-warning"></div>

                        <!-- GHI CHÚ -->
                        <div class="mb-3">

                            <label asp-for="GhiChu"
                                   class="form-label"></label>

                            <input asp-for="GhiChu"
                                   class="form-control" />

                            <span asp-validation-for="GhiChu"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    id="submitBooking"
                                    class="btn btn-primary">

                                Xác nhận đặt phòng

                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>
            </div>

            <!-- LỊCH TÌNH TRẠNG PHÒNG -->
            @if (phong != null)
            {
                <div class="booking-calendar">

                    <h5 class="mb-3">
                        Lịch tình trạng phòng
                    </h5>

                    <div class="calendar-header">

                        <button type="button"
                                id="prevMonth">
                            &#8249;
                        </button>

                        <strong id="calendarMonth"></strong>

                        <button type="button"
                                id="nextMonth">
                            &#8250;
                        </button>

                    </div>

                    <div class="calendar-grid"
                         id="calendarGrid">

                        <div class="calendar-weekday">T2</div>
                        <div class="calendar-weekday">T3</div>
                        <div class="calendar-weekday">T4</div>
                        <div class="calendar-weekday">T5</div>
                        <div class="calendar-weekday">T6</div>
                        <div class="calendar-weekday">T7</div>
                        <div class="calendar-weekday">CN</div>

                    </div>

                    <div class="calendar-legend">

                        <div class="legend-item">

                            <span class="legend-color"
                                  style="background:#dc3545;">
                            </span>

                            Đã có khách đặt

                        </div>

                        <div class="legend-item">

                            <span class="legend-color"
                                  style="background:#f3f8fa;">
                            </span>

                            Còn trống

                        </div>

                        <div class="legend-item">

                            <span class="legend-color"
                                  style="background:white; border:2px solid #0d6efd;">
                            </span>

                            Hôm nay

                        </div>

                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Ngày màu đỏ là ngày phòng đang có khách lưu trú.
                        Ngày trả phòng không bị tính là ngày đã chiếm phòng.
                    </p>

                </div>
            }

        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // Danh sách các đơn đặt phòng còn hiệu lực
        const lichDatPhong = @Html.Raw(lichDatPhongJson);

        const ngayDenInput = document.getElementById("NgayDen");
        const ngayDiInput = document.getElementById("NgayDi");

        const warning = document.getElementById("bookingWarning");
        const submitButton = document.getElementById("submitBooking");
        const bookingForm = document.getElementById("bookingForm");

        // Chuyển yyyy-MM-dd thành Date
        function parseDate(value) {

            if (!value) return null;

            const parts = value.split("-");

            return new Date(
                Number(parts[0]),
                Number(parts[1]) - 1,
                Number(parts[2])
            );
        }

        // Chuyển Date thành yyyy-MM-dd
        function formatDateISO(date) {

            const year = date.getFullYear();

            const month = String(date.getMonth() + 1)
                .padStart(2, "0");

            const day = String(date.getDate())
                .padStart(2, "0");

            return `${year}-${month}-${day}`;
        }

        // Chuyển yyyy-MM-dd thành dd/MM/yyyy
        function formatDateVN(value) {

            if (!value) return "";

            const parts = value.split("-");

            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        // Khởi tạo tháng hiển thị
        let currentMonth = ngayDenInput && ngayDenInput.value
            ? parseDate(ngayDenInput.value)
            : new Date();

        currentMonth = new Date(
            currentMonth.getFullYear(),
            currentMonth.getMonth(),
            1
        );

        // Kiểm tra ngày có khách đang lưu trú
        function isBooked(dateString) {

            return lichDatPhong.some(item =>
                dateString >= item.NgayDen &&
                dateString < item.NgayDi
            );
        }

        // Vẽ lịch
        function renderCalendar() {

            const grid = document.getElementById("calendarGrid");

            if (!grid) return;

            grid.innerHTML = `
                        <div class="calendar-weekday">T2</div>
                        <div class="calendar-weekday">T3</div>
                        <div class="calendar-weekday">T4</div>
                        <div class="calendar-weekday">T5</div>
                        <div class="calendar-weekday">T6</div>
                        <div class="calendar-weekday">T7</div>
                        <div class="calendar-weekday">CN</div>
                    `;

            const year = currentMonth.getFullYear();
            const month = currentMonth.getMonth();

            document.getElementById("calendarMonth").textContent =
                `Tháng ${month + 1}/${year}`;

            const firstDay = new Date(year, month, 1).getDay();

            // Chuyển Chủ nhật về cuối tuần
            const offset = (firstDay + 6) % 7;

            const daysInMonth =
                new Date(year, month + 1, 0).getDate();

            // Ô trống trước ngày đầu tháng
            for (let i = 0; i < offset; i++) {

                const empty = document.createElement("div");

                empty.className = "calendar-day empty";

                grid.appendChild(empty);
            }

            const today = formatDateISO(new Date());

            // Hiển thị các ngày
            for (let day = 1; day <= daysInMonth; day++) {

                const date = new Date(year, month, day);

                const dateString = formatDateISO(date);

                const cell = document.createElement("div");

                cell.className = "calendar-day";

                cell.textContent = day;

                if (isBooked(dateString)) {

                    cell.classList.add("booked");

                    cell.title = "Ngày này phòng đã có khách đặt";
                }

                if (dateString === today) {

                    cell.classList.add("today");
                }

                grid.appendChild(cell);
            }
        }

        // Kiểm tra ngày đặt phòng
        function checkBookingDates() {

            if (!ngayDenInput || !ngayDiInput ||
                !warning || !submitButton) return;

            const ngayDen = ngayDenInput.value;

            const ngayDi = ngayDiInput.value;

            warning.className = "booking-warning";

            warning.textContent = "";

            submitButton.disabled = false;

            if (!ngayDen || !ngayDi) {
                return;
            }

            // Kiểm tra ngày đi phải sau ngày đến
            if (ngayDi <= ngayDen) {

                warning.textContent =
                    "Ngày trả phòng phải sau ngày nhận phòng ít nhất 1 ngày.";

                warning.classList.add("error");

                submitButton.disabled = true;

                return;
            }

            // Tìm các đơn đặt phòng bị trùng
            const cacDonBiTrung = lichDatPhong.filter(item =>

                ngayDen < item.NgayDi &&
                ngayDi > item.NgayDen

            );

            if (cacDonBiTrung.length > 0) {

                const thongBao = cacDonBiTrung.map(item =>

                    `Từ ngày ${formatDateVN(item.NgayDen)} đến ngày ${formatDateVN(item.NgayDi)} đã có người đặt.`

                );

                warning.textContent =
                    thongBao.join(" ") +
                    " Vui lòng chọn ngày khác.";

                warning.classList.add("error");

                submitButton.disabled = true;

            } else {

                warning.textContent =
                    "Khoảng ngày bạn chọn hiện chưa bị trùng với lịch đặt phòng.";

                warning.classList.add("success");
            }
        }

        // Chuyển tháng trước
        document.getElementById("prevMonth")?.addEventListener(
            "click",
            function () {

                currentMonth.setMonth(
                    currentMonth.getMonth() - 1
                );

                renderCalendar();
            }
        );

        // Chuyển tháng sau
        document.getElementById("nextMonth")?.addEventListener(
            "click",
            function () {

                currentMonth.setMonth(
                    currentMonth.getMonth() + 1
                );

                renderCalendar();
            }
        );

        // Kiểm tra khi thay đổi ngày
        ngayDenInput?.addEventListener(
            "change",
            checkBookingDates
        );

        ngayDiInput?.addEventListener(
            "change",
            checkBookingDates
        );

        // Kiểm tra lần cuối trước khi gửi form
        bookingForm?.addEventListener(
            "submit",
            function (event) {

                checkBookingDates();

                if (submitButton.disabled) {

                    event.preventDefault();
                }
            }
        );

        // Khởi tạo lịch và kiểm tra ngày
        renderCalendar();

        checkBookingDates();

    </script>
}
