@model QuanLyKhachSan.Models.ThanhToanCocViewModel

@{
    ViewData["Title"] = "Thanh toán tiền cọc";
    Layout = "_Layout";
}

<style>
    .payment-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(20, 35, 45, 0.6);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        padding: 20px;
    }

        .payment-modal-overlay.show {
            display: flex;
            animation: paymentFadeIn 0.2s ease;
        }

    .payment-modal {
        width: 100%;
        max-width: 460px;
        background: white;
        border-radius: 22px;
        padding: 32px;
        text-align: center;
        box-shadow: 0 15px 50px rgba(0,0,0,0.2);
        animation: paymentModalIn 0.25s ease;
    }

    .payment-modal-icon {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: #e8f3f8;
        color: #4386a0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
    }

        .payment-modal-icon i {
            font-size: 38px;
        }

    .payment-modal h4 {
        font-weight: 700;
        color: #263b45;
        margin-bottom: 12px;
    }

    .payment-modal p {
        color: #71818a;
        line-height: 1.6;
    }

    .payment-modal-amount {
        font-size: 27px;
        font-weight: 700;
        color: #4386a0;
        margin: 18px 0;
    }

    .payment-modal-buttons {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

        .payment-modal-buttons button {
            flex: 1;
            border: none;
            border-radius: 12px;
            padding: 14px 10px;
            font-weight: 600;
            transition: 0.2s;
        }

    .btn-payment-confirm {
        background: #4386a0;
        color: white;
    }

        .btn-payment-confirm:hover {
            background: #326d85;
        }

        .btn-payment-confirm:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .btn-payment-back {
        background: #edf2f5;
        color: #52636d;
    }

        .btn-payment-back:hover {
            background: #dce5ea;
        }

    @@keyframes paymentFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes paymentModalIn {
        from {
            opacity: 0;
            transform: translateY(15px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@media (max-width: 480px) {
        .payment-modal {
            padding: 26px 20px;
        }

        .payment-modal-buttons {
            flex-direction: column;
        }
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="text-center mb-4">

                <span class="badge rounded-pill bg-info text-dark px-3 py-2">
                    THANH TOÁN ĐẶT PHÒNG
                </span>

                <h2 class="fw-bold mt-3">
                    Xác nhận tiền cọc
                </h2>

                <p class="text-muted">
                    Vui lòng kiểm tra thông tin trước khi xác nhận.
                </p>

            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-house-door me-2"></i>
                        Thông tin đặt phòng
                    </h5>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Khách hàng
                            </div>

                            <div class="fw-semibold">
                                @Model.HoTenKhachHang
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Phòng
                            </div>

                            <div class="fw-semibold">
                                @Model.SoPhong - @Model.TenLoaiPhong
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Ngày nhận phòng
                            </div>

                            <div class="fw-semibold">
                                @Model.NgayDen.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Ngày trả phòng
                            </div>

                            <div class="fw-semibold">
                                @Model.NgayDi.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Số đêm
                            </div>

                            <div class="fw-semibold">
                                @Model.SoDem đêm
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Giá một đêm
                            </div>

                            <div class="fw-semibold">
                                @Model.GiaMotDem.ToString("N0") VNĐ
                            </div>
                        </div>

                    </div>

                    <hr />

                    <h5 class="fw-bold mb-4">
                        Chi tiết thanh toán
                    </h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Tổng tiền phòng
                        </span>

                        <strong>
                            @Model.TongTien.ToString("N0") VNĐ
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="text-muted">
                            Tiền cọc (@Model.PhanTramCoc%)
                        </span>

                        <strong class="text-primary fs-5">
                            @Model.TienCoc.ToString("N0") VNĐ
                        </strong>

                    </div>

                    <div class="alert alert-info rounded-3">

                        <i class="bi bi-info-circle me-2"></i>

                        Khách hàng cần xác nhận khoản tiền cọc
                        @Model.PhanTramCoc% để hoàn tất xác nhận đặt phòng.

                    </div>

                    <hr />

                    <div class="text-center py-3">

                        <h5 class="fw-bold mb-3">
                            Mã QR thanh toán minh họa
                        </h5>

                        <div class="d-inline-flex flex-column align-items-center border rounded-4 p-4 bg-light">

                            <div class="bg-white p-3 rounded-3">

                                <div style="
                                    width:180px;
                                    height:180px;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    border:2px dashed #8eb8c8;
                                    border-radius:12px;
                                    color:#557f91;
                                    text-align:center;
                                    padding:15px;">

                                    <div>

                                        <div style="font-size:55px;">
                                            <i class="bi bi-qr-code"></i>
                                        </div>

                                        <strong>QR MINH HỌA</strong>

                                        <div class="small mt-2">
                                            KHÔNG GIAO DỊCH THẬT
                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="fw-bold text-primary mt-3">
                                @Model.TienCoc.ToString("N0") VNĐ
                            </div>

                            <div class="text-muted small">
                                Tiền cọc mô phỏng
                            </div>

                        </div>

                    </div>

                    <div class="alert alert-warning rounded-3 mt-3">

                        <strong>
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Lưu ý:
                        </strong>

                        <ul class="mb-0 mt-2">
                            <li>
                                Đây là chức năng thanh toán mô phỏng phục vụ trình diễn.
                            </li>

                            <li>
                                Mã QR không dùng để chuyển tiền thật.
                            </li>

                            <li>
                                Không có giao dịch ngân hàng thực tế.
                            </li>
                        </ul>

                    </div>

                    @if (Model.TrangThaiThanhToan == "ThanhCong")
                    {
                        <div class="alert alert-success text-center rounded-3">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Khoản thanh toán mô phỏng đã được xác nhận thành công.
                            Đặt phòng của bạn đã được xác nhận.

                        </div>

                        <a asp-action="PhongCuaToi"
                           asp-controller="DatPhongs"
                           class="btn btn-success w-100 rounded-pill py-3 fw-bold">

                            <i class="bi bi-house-check me-2"></i>
                            Xem phòng của tôi

                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center rounded-3">

                            <i class="bi bi-clock-history me-2"></i>

                            Đơn đặt phòng đang chờ xác nhận tiền cọc.

                        </div>

                        <form asp-action="XacNhanThanhToanMoPhong"
                              asp-controller="DatPhongs"
                              method="post"
                              id="formXacNhanThanhToan">

                            <input type="hidden"
                                   name="id"
                                   value="@Model.MaDatPhong" />

                            @Html.AntiForgeryToken()

                            <button type="button"
                                    id="btnMoXacNhanThanhToan"
                                    class="btn btn-primary w-100 rounded-pill py-3 fw-bold">

                                <i class="bi bi-check-circle me-2"></i>

                                Xác nhận thanh toán mô phỏng

                            </button>

                        </form>
                    }

                    <div class="text-center mt-3">

                        <a asp-action="PhongCuaToi"
                           asp-controller="DatPhongs"
                           class="text-decoration-none text-muted">

                            <i class="bi bi-arrow-left me-1"></i>
                            Quay lại phòng của tôi

                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- HỘP THOẠI XÁC NHẬN THANH TOÁN -->
<div class="payment-modal-overlay" id="modalXacNhanThanhToan">

    <div class="payment-modal">

        <div class="payment-modal-icon">

            <i class="bi bi-wallet2"></i>

        </div>

        <h4>
            Xác nhận thanh toán tiền cọc
        </h4>

        <p>
            Bạn có chắc chắn muốn xác nhận thanh toán mô phỏng
            cho đơn đặt phòng này không?
        </p>

        <div class="text-muted small">
            Số tiền cọc
        </div>

        <div class="payment-modal-amount">
            @Model.TienCoc.ToString("N0") VNĐ
        </div>

        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
            Thanh toán mô phỏng
        </span>

        <div class="payment-modal-buttons">

            <button type="button"
                    class="btn-payment-confirm"
                    id="btnXacNhanThanhToan">

                Xác nhận thanh toán

            </button>

            <button type="button"
                    class="btn-payment-back"
                    id="btnQuayLaiThanhToan">

                Quay lại

            </button>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modal = document.getElementById("modalXacNhanThanhToan");

        const btnMo = document.getElementById("btnMoXacNhanThanhToan");

        const btnXacNhan = document.getElementById("btnXacNhanThanhToan");

        const btnQuayLai = document.getElementById("btnQuayLaiThanhToan");

        const form = document.getElementById("formXacNhanThanhToan");

        if (!modal || !btnMo || !btnXacNhan || !btnQuayLai || !form) {
            return;
        }

        // Mở hộp thoại
        btnMo.addEventListener("click", function () {

            modal.classList.add("show");

        });

        // Quay lại
        btnQuayLai.addEventListener("click", function () {

            modal.classList.remove("show");

        });

        // Đóng khi bấm ra ngoài
        modal.addEventListener("click", function (e) {

            if (e.target === modal) {

                modal.classList.remove("show");

            }

        });

        // Xác nhận thanh toán mô phỏng
        btnXacNhan.addEventListener("click", function () {

            btnXacNhan.disabled = true;

            btnXacNhan.innerText = "Đang xử lý...";

            form.submit();

        });

        // Đóng bằng phím Escape
        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape") {

                modal.classList.remove("show");

            }

        });

    });
</script>
