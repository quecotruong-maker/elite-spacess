@model List<Order>
<h2>Đơn hàng của tôi</h2>@if(Model.Count==0){<p>Bạn chưa có đơn hàng.</p>}else{foreach(var o in Model){<div class="card mb-3"><div class="card-body"><h5>Đơn #@o.Id <span class="badge bg-secondary">@o.Status</span></h5><small>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small><p>Địa chỉ: @o.Address</p><ul>@foreach(var i in o.Items){<li>@i.ProductName × @i.Quantity</li>}</ul><strong>@o.Total.ToString("N0") ₫</strong></div></div>}}