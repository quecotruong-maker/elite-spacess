@model IEnumerable<QuanLyKhachSan.Models.ThongBao>

@{
    ViewData["Title"] = "Thông báo của tôi";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-2">Thông báo của tôi</h2>
            <p class="text-muted mb-0">
                Theo dõi các thông tin và nhắc nhở về đặt phòng.
            </p>
        </div>

        <span class="badge rounded-pill bg-primary px-3 py-2 fs-6">
            Chưa đọc: @(ViewBag.SoThongBaoChuaDoc ?? 0)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5 bg-light rounded-4">
            <div class="mb-3">
                <i class="bi bi-bell fs-1 text-secondary"></i>
            </div>
            <h5 class="fw-semibold">Bạn chưa có thông báo nào</h5>
            <p class="text-muted mb-0">
                Các thông báo về đặt phòng sẽ xuất hiện tại đây.
            </p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card border-0 shadow-sm rounded-3
                    @(item.DaDoc ? "bg-white" : "bg-light")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                @if (!item.DaDoc)
                                {
                                    <span class="badge bg-primary">Mới</span>
                                }

                                <h5 class="fw-semibold mb-0">
                                    @item.TieuDe
                                </h5>
                            </div>

                            <small class="text-muted">
                                @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        <p class="text-muted mt-3 mb-3">
                            @item.NoiDung
                        </p>

                        <form asp-controller="ThongBao"
                              asp-action="Mo"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.MaThongBao" />

                            <button type="submit"
                                    class="btn btn-outline-primary btn-sm">
                                Xem chi tiết đặt phòng
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
