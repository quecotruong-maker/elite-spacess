@{
    ViewData["Title"] = "Báo cáo và thống kê";
    var topLoaiPhong = ViewBag.TopLoaiPhong;
}

<style>
    .report-page {
        padding: 20px 0 40px;
        color: #244454;
    }

    .report-header {
        margin-bottom: 25px;
    }

    .report-title {
        font-size: 28px;
        font-weight: 800;
        color: #183b4e;
    }

    .report-subtitle {
        color: #71838d;
        margin-top: 5px;
    }

    .report-filter {
        background: white;
        padding: 22px;
        border-radius: 14px;
        border: 1px solid #e3ebef;
        margin-bottom: 25px;
    }

        .report-filter label {
            font-weight: 600;
            margin-bottom: 7px;
        }

        .report-filter input {
            border: 1px solid #d6e1e7;
            border-radius: 8px;
            padding: 10px;
            width: 100%;
        }

    .btn-report {
        background: #287f9b;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
    }

        .btn-report:hover {
            background: #1c657d;
            color: white;
        }

    .report-card {
        background: white;
        border: 1px solid #e5edf1;
        border-radius: 14px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(30,70,90,.04);
    }

    .report-label {
        color: #758994;
        font-size: 14px;
        font-weight: 600;
    }

    .report-number {
        font-size: 27px;
        font-weight: 800;
        color: #183b4e;
        margin-top: 12px;
    }

    .report-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #e8f4f7;
        color: #287f9b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .report-section {
        background: white;
        border: 1px solid #e5edf1;
        border-radius: 14px;
        padding: 24px;
        margin-top: 25px;
    }

        .report-section h5 {
            font-weight: 800;
            color: #183b4e;
            margin-bottom: 20px;
        }

    .report-table th {
        background: #f1f7f9;
        color: #365565;
        font-weight: 700;
        padding: 13px;
    }

    .report-table td {
        padding: 13px;
        vertical-align: middle;
    }

    .report-progress {
        height: 9px;
        background: #e8eff2;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 8px;
    }

        .report-progress div {
            height: 100%;
            background: #48a3b8;
            border-radius: 20px;
        }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }
</style>

<div class="container report-page">

    <div class="report-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="report-title">Báo cáo và thống kê</h2>
                <p class="report-subtitle">
                    Tổng quan tình hình kinh doanh khách sạn
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                ← Trang tổng quan
            </a>
        </div>
    </div>

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Loi"]
        </div>
    }

    <form asp-action="BaoCao" method="get" class="report-filter">
        <div class="row align-items-end g-3">
            <div class="col-md-4">
                <label>Từ ngày</label>
                <input type="date"
                       name="tuNgay"
                       value="@ViewBag.TuNgay"
                       required />
            </div>

            <div class="col-md-4">
                <label>Đến ngày</label>
                <input type="date"
                       name="denNgay"
                       value="@ViewBag.DenNgay"
                       required />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn-report w-100">
                    Xem báo cáo
                </button>
            </div>
        </div>
    </form>

    <div class="row g-3">

        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <div class="report-label">Tổng lượt đặt phòng</div>
                    <div class="report-icon">▣</div>
                </div>
                <div class="report-number">
                    @ViewBag.TongLuotDat
                </div>
                <small class="text-muted">Trong khoảng thời gian chọn</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <div class="report-label">Lượt đặt thành công</div>
                    <div class="report-icon">✓</div>
                </div>
                <div class="report-number">
                    @ViewBag.LuotThanhCong
                </div>
                <small class="text-muted">Không bao gồm đơn đã hủy</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <div class="report-label">Lượt đặt đã hủy</div>
                    <div class="report-icon">×</div>
                </div>
                <div class="report-number">
                    @ViewBag.LuotDaHuy
                </div>
                <small class="text-muted">Đơn đặt phòng đã hủy</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <div class="report-label">Doanh thu</div>
                    <div class="report-icon">₫</div>
                </div>
                <div class="report-number" style="font-size:23px">
                    @(((decimal)ViewBag.DoanhThu).ToString("N0")) đ
                </div>
                <small class="text-muted">
                    Giao dịch thanh toán thành công
                </small>
            </div>
        </div>

    </div>

    <div class="row g-3 mt-1">

        <div class="col-md-6">
            <div class="report-card">
                <div class="report-label">Tỷ lệ lấp đầy phòng</div>

                <div class="report-number">
                    @ViewBag.TyLeLapDay%
                </div>

                <div class="report-progress">
                    <div style="width:@(Math.Min(100, (double)ViewBag.TyLeLapDay))%"></div>
                </div>

                <small class="text-muted d-block mt-3">
                    Tổng số đêm phòng được sử dụng:
                    <strong>@ViewBag.TongDemPhong</strong>
                </small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="report-card">
                <div class="report-label">Quy mô khách sạn</div>

                <div class="report-number">
                    @ViewBag.TongPhong phòng
                </div>

                <small class="text-muted">
                    Tổng số phòng trong hệ thống
                </small>
            </div>
        </div>

    </div>

    <!-- BIỂU ĐỒ -->
    <div class="row g-3 mt-2">

        <div class="col-lg-6">
            <div class="report-section h-100">
                <h5>Biểu đồ doanh thu theo tháng</h5>
                <div class="chart-container">
                    <canvas id="doanhThuChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="report-section h-100">
                <h5>Biểu đồ lượt đặt phòng theo tháng</h5>
                <div class="chart-container">
                    <canvas id="datPhongChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- BẢNG LOẠI PHÒNG -->
    <div class="report-section">
        <h5>Loại phòng được đặt nhiều nhất</h5>

        <div class="table-responsive">
            <table class="table report-table table-hover">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Loại phòng</th>
                        <th>Số lượt đặt</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int stt = 1;
                    }

                    @if (topLoaiPhong != null && topLoaiPhong.Count > 0)
                    {
                        foreach (var item in topLoaiPhong)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="fw-semibold">@item.TenLoai</td>
                                <td>@item.SoLuot lượt</td>
                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                Chưa có dữ liệu đặt phòng trong khoảng thời gian này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const nhanBieuDo = @Html.Raw(ViewBag.NhanBieuDo);
    const doanhThu = @Html.Raw(ViewBag.DoanhThuTheoThang);
    const luotDat = @Html.Raw(ViewBag.LuotDatTheoThang);

    // BIỂU ĐỒ DOANH THU
    new Chart(document.getElementById('doanhThuChart'), {
        type: 'bar',
        data: {
            labels: nhanBieuDo,
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: doanhThu,
                backgroundColor: '#48a3b8',
                borderRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.parsed.y.toLocaleString('vi-VN') + ' đ';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('vi-VN') + ' đ';
                        }
                    }
                }
            }
        }
    });

    // BIỂU ĐỒ LƯỢT ĐẶT PHÒNG
    new Chart(document.getElementById('datPhongChart'), {
        type: 'line',
        data: {
            labels: nhanBieuDo,
            datasets: [{
                label: 'Lượt đặt phòng',
                data: luotDat,
                borderColor: '#287f9b',
                backgroundColor: 'rgba(40,127,155,0.12)',
                fill: true,
                tension: 0.35,
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>
