@model QuanLyKhachSan.Models.DatPhong

@{
    ViewData["Title"] = "Chi tiết đặt phòng";

    int soDem = Math.Max(1, (Model.NgayDi.Date - Model.NgayDen.Date).Days);
    decimal giaMotDem = Model.Phong?.LoaiPhong?.GiaMotDem ?? 0;
    decimal tongTienDuKien = soDem * giaMotDem;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Chi tiết đặt phòng</h2>
            <p class="text-muted mb-0">
                Thông tin đặt phòng của bạn tại khách sạn.
            </p>
        </div>

        <a asp-controller="DatPhongs"
           asp-action="PhongCuaToi"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4">

            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2 mb-3">
                

                @if (Model.TrangThai == "Đã đặt")
                {
                    <span class="badge bg-primary p-2">Đã đặt</span>
                }
                else if (Model.TrangThai == "Đã check-in")
                {
                    <span class="badge bg-success p-2">Đang lưu trú</span>
                }
                else if (Model.TrangThai == "Đã check-out")
                {
                    <span class="badge bg-secondary p-2">Đã trả phòng</span>
                }
                else if (Model.TrangThai == "Đã hủy")
                {
                    <span class="badge bg-danger p-2">Đã hủy</span>
                }
                else
                {
                    <span class="badge bg-secondary p-2">@Model.TrangThai</span>
                }
            </div>

            <hr />

            <h5 class="fw-bold mb-3">Thông tin phòng</h5>

            <div class="row g-4">
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Model.Phong?.HinhAnh))
                    {
                        <img src="@Model.Phong.HinhAnh"
                             class="img-fluid rounded w-100"
                             style="height:260px; object-fit:cover;"
                             alt="Ảnh phòng @Model.Phong.SoPhong" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                             style="height:260px;">
                            <span class="text-muted">Chưa có ảnh phòng</span>
                        </div>
                    }
                </div>

                <div class="col-md-7">
                    <div class="mb-3">
                        <small class="text-muted">Số phòng</small>
                        <h5 class="fw-bold">@Model.Phong?.SoPhong</h5>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Loại phòng</small>
                        <h5 class="fw-bold">@Model.Phong?.LoaiPhong?.TenLoai</h5>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Giá mỗi đêm</small>
                        <h5 class="fw-bold text-primary">
                            @giaMotDem.ToString("N0") VNĐ
                        </h5>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Thời gian đặt phòng</h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted">Ngày nhận phòng</small>
                    <div class="fw-bold">
                        @Model.NgayDen.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">Ngày trả phòng</small>
                    <div class="fw-bold">
                        @Model.NgayDi.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">Số đêm</small>
                    <div class="fw-bold">@soDem đêm</div>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Thông tin khác</h5>

            <div class="mb-3">
                <small class="text-muted">Ghi chú đặt phòng</small>
                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model.GhiChu)
                        ? "Không có ghi chú."
                        : Model.GhiChu)
                </p>
            </div>

            <div class="rounded p-3 mt-4" style="background:#eef5fb;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Tổng tiền dự kiến</span>
                    <h4 class="fw-bold text-primary mb-0">
                        @tongTienDuKien.ToString("N0") VNĐ
                    </h4>
                </div>
                <small class="text-muted">
                    Tính theo giá phòng mỗi đêm × số đêm. Số tiền thực tế có thể được xác nhận trên hóa đơn.
                </small>
            </div>

        </div>
    </div>
</div>
