@model QuanLyKhachSan.Models.LoaiPhong

@{
    ViewData["Title"] = "Thêm loại phòng";
}

<style>
    .create-type-page {
        padding: 10px 0 35px;
        animation: typeCreateFade .45s ease;
    }

    .create-type-title {
        color: #183b4e;
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .create-type-subtitle {
        color: #82939e;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .create-type-card {
        background: #fff;
        border: 1px solid #e8eef2;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(32, 71, 91, .06);
        overflow: hidden;
    }

    .create-type-card-header {
        padding: 22px 28px;
        border-bottom: 1px solid #edf1f3;
        background: linear-gradient(135deg, #f5fbfc, #fff);
    }

        .create-type-card-header h5 {
            color: #24485a;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .create-type-card-header p {
            color: #91a0a9;
            font-size: 13px;
            margin: 0;
        }

    .create-type-content {
        padding: 28px;
    }

    .create-type-label {
        color: #365666;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .create-type-control {
        min-height: 47px;
        border: 1px solid #dfe8ed;
        border-radius: 11px;
        padding: 10px 14px;
        color: #294b5b;
        transition: all .2s ease;
    }

        .create-type-control:focus {
            border-color: #16a1ad;
            box-shadow: 0 0 0 3px rgba(22, 161, 173, .12);
        }

    .create-type-help {
        color: #91a0a9;
        font-size: 12px;
        margin-top: 7px;
    }

    .create-type-preview {
        height: 100%;
        min-height: 350px;
        padding: 25px;
        border-radius: 16px;
        background: linear-gradient(145deg, #eaf7f8, #f7fbfc);
        border: 1px solid #e0eff1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .create-type-preview-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: #d8f0f1;
        color: #078d9c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin-bottom: 22px;
    }

    .create-type-preview-title {
        font-size: 22px;
        font-weight: 800;
        color: #24485a;
        margin-bottom: 8px;
        overflow-wrap: anywhere;
    }

    .create-type-preview-description {
        color: #82939e;
        font-size: 13px;
        line-height: 1.6;
        min-height: 42px;
        margin-bottom: 25px;
        overflow-wrap: anywhere;
    }

    .create-type-preview-price {
        font-size: 27px;
        font-weight: 800;
        color: #0796a5;
        margin-bottom: 15px;
    }

    .create-type-preview-person {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #e3eff1;
        border-radius: 10px;
        padding: 10px 13px;
        color: #347ba6;
        font-size: 13px;
        font-weight: 700;
        width: fit-content;
    }

    .create-type-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf1f3;
    }

    .create-type-btn {
        min-height: 45px;
        padding: 10px 22px;
        border: none;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s ease;
    }

        .create-type-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(30, 70, 90, .12);
        }

    .btn-save-type {
        color: #fff;
        background: linear-gradient(135deg, #0799a8, #087c91);
    }

    .btn-back-type {
        color: #526b78;
        background: #edf2f5;
    }

    @@keyframes typeCreateFade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .create-type-content {
            padding: 20px;
        }

        .create-type-title {
            font-size: 23px;
        }

        .create-type-preview {
            min-height: 280px;
        }

        .create-type-btn {
            flex: 1 1 100%;
        }
    }
</style>

<div class="container-fluid create-type-page">

    <h2 class="create-type-title">Thêm loại phòng mới</h2>

    <p class="create-type-subtitle">
        Tạo danh mục loại phòng và thiết lập giá, sức chứa cho khách sạn
    </p>

    <div class="create-type-card">

        <div class="create-type-card-header">
            <h5>
                <i class="bi bi-plus-circle me-2"></i>
                Thông tin loại phòng
            </h5>
            <p>Nhập thông tin loại phòng mới vào hệ thống</p>
        </div>

        <div class="create-type-content">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3"></div>

                <div class="row g-4">

                    <div class="col-lg-7">

                        <div class="mb-4">
                            <label asp-for="TenLoai" class="create-type-label">
                                Tên loại phòng
                            </label>

                            <input asp-for="TenLoai"
                                   id="typeName"
                                   class="form-control create-type-control"
                                   placeholder="Ví dụ: Phòng VIP, Phòng Deluxe..." />

                            <span asp-validation-for="TenLoai"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="GiaMotDem" class="create-type-label">
                                Giá một đêm (VNĐ)
                            </label>

                            <div class="input-group">
                                <input asp-for="GiaMotDem"
                                       id="typePrice"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control create-type-control"
                                       placeholder="Ví dụ: 500000" />

                                <span class="input-group-text"
                                      style="border-radius:0 11px 11px 0;background:#f5f9fa;border-color:#dfe8ed;color:#6c8794;font-weight:700;">
                                    VNĐ
                                </span>
                            </div>

                            <span asp-validation-for="GiaMotDem"
                                  class="text-danger small"></span>

                            <div class="create-type-help">
                                Nhập số liền, không có dấu chấm hoặc dấu phẩy.
                                Ví dụ: 500000
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SoNguoiToiDa" class="create-type-label">
                                Số người tối đa
                            </label>

                            <div class="input-group">
                                <input asp-for="SoNguoiToiDa"
                                       id="typeCapacity"
                                       type="number"
                                       min="1"
                                       class="form-control create-type-control"
                                       placeholder="Ví dụ: 2" />

                                <span class="input-group-text"
                                      style="border-radius:0 11px 11px 0;background:#f5f9fa;border-color:#dfe8ed;color:#6c8794;font-weight:700;">
                                    Người
                                </span>
                            </div>

                            <span asp-validation-for="SoNguoiToiDa"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="create-type-label">
                                Mô tả loại phòng
                            </label>

                            <textarea asp-for="MoTa"
                                      id="typeDescription"
                                      class="form-control create-type-control"
                                      rows="4"
                                      placeholder="Mô tả đặc điểm và tiện nghi của loại phòng..."></textarea>

                            <span asp-validation-for="MoTa"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <div class="col-lg-5">

                        <div class="create-type-preview">

                            <div class="create-type-preview-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <div class="small text-uppercase fw-bold mb-2"
                                 style="color:#829ba5;letter-spacing:1px;">
                                Xem trước loại phòng
                            </div>

                            <div class="create-type-preview-title"
                                 id="previewName">
                                Tên loại phòng
                            </div>

                            <div class="create-type-preview-description"
                                 id="previewDescription">
                                Mô tả loại phòng sẽ hiển thị tại đây.
                            </div>

                            <div class="create-type-preview-price"
                                 id="previewPrice">
                                0 đ
                            </div>

                            <div class="create-type-preview-person">
                                <i class="bi bi-people"></i>
                                <span id="previewCapacity">0 người tối đa</span>
                            </div>

                        </div>

                    </div>

                </div>

                <div class="create-type-actions">

                    <button type="submit" class="create-type-btn btn-save-type">
                        <i class="bi bi-check-circle"></i>
                        Lưu loại phòng
                    </button>

                    <a asp-action="Index"
                       class="create-type-btn btn-back-type">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const typeName = document.getElementById("typeName");
        const typePrice = document.getElementById("typePrice");
        const typeCapacity = document.getElementById("typeCapacity");
        const typeDescription = document.getElementById("typeDescription");

        const previewName = document.getElementById("previewName");
        const previewPrice = document.getElementById("previewPrice");
        const previewCapacity = document.getElementById("previewCapacity");
        const previewDescription = document.getElementById("previewDescription");

        function updateTypePreview() {
            previewName.textContent =
                typeName.value.trim() || "Tên loại phòng";

            const price = Number(typePrice.value);

            previewPrice.textContent =
                Number.isFinite(price) && typePrice.value !== ""
                    ? price.toLocaleString("vi-VN") + " đ"
                    : "0 đ";

            previewCapacity.textContent =
                (typeCapacity.value || "0") + " người tối đa";

            previewDescription.textContent =
                typeDescription.value.trim() ||
                "Mô tả loại phòng sẽ hiển thị tại đây.";
        }

        [typeName, typePrice, typeCapacity, typeDescription]
            .forEach(input => {
                input.addEventListener("input", updateTypePreview);
            });

        updateTypePreview();
    </script>
}
